{
  "name": "fitsyou-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "FitsYou backend service: fashion social feed, body profiling, and AI try-on pipeline",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run --config vitest.config.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "seed": "tsx prisma/seed.ts",
    "smoke:tryon": "tsx scripts/smoke-tryon.ts"
  },
  "dependencies": {
    "@clerk/backend": "^3.26.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/sensible": "^6.0.3",
    "@google/genai": "^2.31.0",
    "@prisma/client": "^6.4.1",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "prisma": "^6.4.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
