DATABASE_URL="postgresql://user:password@ep-pooler.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-direct.neon.tech/neondb?sslmode=require"
TEST_DATABASE_URL="postgresql://user:password@ep-test-pooler.neon.tech/neondb?sslmode=require"
PORT=3000
NODE_ENV=development

# Try-On and Model Configuration
TRYON_MODE=live
GEMINI_API_KEY=""
GEMINI_IMAGE_MODEL="gemini-2.5-flash-image"
GEMINI_MAX_RPM=15
TRYON_DAILY_LIMIT=10
WORKER_CONCURRENCY=3

# Auth Configuration
AUTH_DEMO_MODE=false
CLERK_SECRET_KEY=""
CLERK_PUBLISHABLE_KEY=""

# Security & CORS
CORS_ORIGINS="http://localhost:5173,https://yourdomain.com"

# Recommender & Storage
FEED_STALE_HOURS=6
STORAGE_PROVIDER="supabase"
STORAGE_BUCKET="fitsyou-storage"
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
