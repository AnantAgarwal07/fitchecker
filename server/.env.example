DATABASE_URL="postgresql://user:password@ep-pooler.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-direct.neon.tech/neondb?sslmode=require"
TEST_DATABASE_URL="postgresql://user:password@ep-test-pooler.neon.tech/neondb?sslmode=require"
PORT=3000
NODE_ENV=development

# Try-On and Model Configuration
TRYON_MODE=demo # Default is 'demo' (photorealistic demo render). Set to 'live' for multimodal Gemini AI generation (requires GEMINI_API_KEY).
GEMINI_API_KEY="" # Required when TRYON_MODE=live. Server fails loudly on startup or session start if live mode lacks this key.
GEMINI_IMAGE_MODEL="gemini-2.5-flash-image"
GEMINI_MAX_RPM=15
TRYON_DAILY_LIMIT=10
WORKER_CONCURRENCY=3

# Worker Execution
INLINE_WORKER=true # When true, executes queued try-on jobs inline in server process via setImmediate (recommended for local dev without a separate worker process). Set to false in production to let worker.ts process jobs.

# Auth Configuration
AUTH_DEMO_MODE=false
CLERK_SECRET_KEY=""
CLERK_PUBLISHABLE_KEY=""

# Security & CORS
CORS_ORIGINS="http://localhost:5173,https://yourdomain.com"

# Recommender & Storage
FEED_STALE_HOURS=6
DEBUG_TIMING=false # When true, prints per-step latency logs for candidate querying, scoring, and hydration
# Set STORAGE_PROVIDER to 'local' for local disk uploads (stored in server/uploads/ and served at /uploads/)
# Choosing 'supabase' additionally requires SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY
STORAGE_PROVIDER="local"
STORAGE_BUCKET="fitsyou-storage"
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

